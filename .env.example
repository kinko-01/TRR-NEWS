# Required in production: generate a long random value.
SECRET_KEY=replace-with-a-long-random-secret

# Local development only. For Vercel, set DATABASE_URL to a managed PostgreSQL connection string
# in Vercel Project Settings > Environment Variables.
DATABASE_URL=sqlite:///trr_news.db

# Public canonical site URL (used for absolute URLs in sitemap and absolute links).
TRR_SITE_URL=http://127.0.0.1:5000

# Google authentication is disabled for the early release.
GOOGLE_AUTH_ENABLED=false
# Keep these for a future re-enable; do not commit real secrets.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Database/bootstrap controls.
AUTO_CREATE_DB=true
SEED_SAMPLE_CONTENT=false

# Production rate limiting should use shared storage such as Redis.
RATELIMIT_ENABLED=true
RATELIMIT_STORAGE_URI=memory://

# Upload controls.
MAX_CONTENT_LENGTH=8388608
MAX_IMAGE_PIXELS=25000000
# UPLOAD_FOLDER=/var/lib/trr-news/uploads

# Set these to true only when the site is served over HTTPS.
SESSION_COOKIE_SECURE=false
REMEMBER_COOKIE_SECURE=false

# Vercel note: uploaded article images are disabled in this preview build until external image storage is configured.
